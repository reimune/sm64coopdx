<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest template for sideloading onto an Xbox in Dev Mode.
  Replace Identity Name/Publisher with the values from your Partner Center account
  (Product management > Product identity), or let Visual Studio associate the app
  with the Store to fill them in. Provide the logo PNGs in uwp/Assets.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <Identity
    Name="REPLACE-WITH-YOUR-IDENTITY-NAME"
    Publisher="CN=REPLACE-WITH-YOUR-PUBLISHER-ID"
    Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="00000000-0000-0000-0000-000000000000" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>SM64 CoopDX (personal build)</DisplayName>
    <PublisherDisplayName>REPLACE</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows.Universal runs on Xbox; no need to restrict to Windows.Xbox. -->
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="sm64coopdx.exe" EntryPoint="sm64coopdx.App">
      <uap:VisualElements
        DisplayName="SM64 CoopDX"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Super Mario 64 CoopDX, personal build"
        BackgroundColor="#202020">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>
</Package>
